# ═══ JULLBRAIN — Variables de Entorno (copiar a .env y completar) ═══
# El archivo .env real está excluido de git (.gitignore línea 23)

# ── Entorno activo (local | colab | oracle | ibmcloud) ────────────
JULLBRAIN_ENV=local

# ── Salt de auditoría (cambiar en producción) ────────────────────
JULLBRAIN_AUDIT_SALT=EnterpriseLegalRAG_2026_Salt

# ── Salt de cuadernos (cambiar en producción) ────────────────────
JULLBRAIN_NOTEBOOK_SALT=JullBrain_Legal_Salt_2026

# ── Oracle Cloud (solo si JULLBRAIN_ENV=oracle) ──────────────────
ORACLE_OBJECT_STORAGE_BUCKET=jullbrain-rag
ORACLE_NAMESPACE=
ORACLE_REGION=sa-vinhedo-1

# ── Google Drive (solo si JULLBRAIN_ENV=colab) ───────────────────
GOOGLE_DRIVE_BASE=/content/drive/MyDrive/JullBrain

# ── IBM Cloud (solo si JULLBRAIN_ENV=ibmcloud) ───────────────────
# IBM_COS_API_KEY=
# IBM_COS_INSTANCE_ID=
