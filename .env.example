# ==============================================================================
# JullBrain v0.2.0 — Configuración de Entorno (Zero-Trust / Air-Gapped / OCI)
# ==============================================================================

# 1. Entorno de Ejecución (local | podman | oracle)
JULLBRAIN_ENV=local
JULLBRAIN_PORT=8080

# 2. Núcleo de Datos y Bóveda Local de Modelos IA (Ciberseguridad IBM)
JULLBRAIN_MODEL_VAULT=./RAG/modelos_ia
DOCLING_ARTIFACTS_PATH=./RAG/modelos_ia/docling
HF_HOME=./RAG/modelos_ia/huggingface
TORCH_HOME=./RAG/modelos_ia/torch
OLLAMA_MODELS=./RAG/modelos_ia/ollama

# 3. Aislamiento Zero-Telemetry (Sin fugas de datos a terceros)
HF_HUB_DISABLE_TELEMETRY=1
DO_NOT_TRACK=1
ANONYMIZED_TELEMETRY=False
HF_HUB_OFFLINE=0

# 4. Criptografía Forense (ISO/IEC 27037 / NIST AI RMF)
JULLBRAIN_AUDIT_SECRET=CAMBIAR_CLAVE_HMAC_FORENSE_EN_PRODUCCION_2026
JULLBRAIN_NOTEBOOK_SALT=CAMBIAR_SALT_SHA256_EXPEDIENTES_2026
JULLBRAIN_LOG_DIR=./logs

# 5. Motor IBM Granite (Ollama Local / Podman)
OLLAMA_HOST=http://localhost:11434
JULLBRAIN_LLM_MODEL=ibm-granite/granite-3.3-8b-instruct-GGUF
JULLBRAIN_EMBEDDING_MODEL=ibm-granite/granite-embedding-english-r2
JULLBRAIN_GUARDIAN_MODEL=ibm-granite/granite-guardian-3.2-5b

# 6. Oracle Cloud Infrastructure (OCI) — Única Nube Autorizada
OCI_REGION=sa-saopaulo-1
OCI_COMPARTMENT_OCID=ocid1.compartment.oc1..xxxx
OCI_BUCKET_NAME=jullbrain-normativas-ve
