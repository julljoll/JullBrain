                "t": 129.85791015625,
                "r": 511.0353088378906,
                "b": 119.14484405517578,
                "coord_origin": "BOTTOMLEFT"
              },
              "charspan": [
                0,
                77
              ]
            },
            {
              "page_no": 4,
              "bbox": {
                "l": 87.81719207763672,
                "t": 733.703125,
                "r": 511.1087646484375,
                "b": 696.0416870117188,
                "coord_origin": "BOTTOMLEFT"
              },
              "charspan": [
