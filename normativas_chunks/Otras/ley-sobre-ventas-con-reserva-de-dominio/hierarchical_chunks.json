        "Artículo 14°"
      ],
      "captions": null,
      "origin": null
    }
  },
  {
    "text": "El aumento del valor adquirido por la cosa quedará sin indemnización, en provecho del vendedor con reserva de dominio cuando aquélla vuelva a éste por incumplimiento del comprador.",
    "meta": {
      "schema_name": "docling_core.transforms.chunker.DocMeta",
      "version": "1.0.0",
      "doc_items": [
        {
          "self_ref": "#/texts/37",
          "parent": {
            "cref": "#/body"
          },
          "children": [],
          "content_layer": "body",
          "meta": null,
          "label": "text",
          "prov": [
            {
              "page_no": 3,
              "bbox": {
