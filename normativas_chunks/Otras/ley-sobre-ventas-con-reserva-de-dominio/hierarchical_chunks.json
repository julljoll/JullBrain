              ]
            }
          ]
        }
      ],
      "headings": [
        "Artículo 17°"
      ],
      "captions": null,
      "origin": null
    }
  },
  {
    "text": "No obstante lo dispuesto en el artículo precedente, la masa de acreedores del fallido puede conservar las cosas vendidas, pagando de una vez al vendedor todo cuanto se le adeude por razón de éstas últimas.",
    "meta": {
      "schema_name": "docling_core.transforms.chunker.DocMeta",
      "version": "1.0.0",
      "doc_items": [
        {
          "self_ref": "#/texts/43",
          "parent": {
            "cref": "#/body"
          },
          "children": [],
          "content_layer": "body",
          "meta": null,
          "label": "text",
          "prov": [
            {
              "page_no": 4,
              "bbox": {
                "l": 87.52543640136719,
                "t": 666.622802734375,
                "r": 511.0225830078125,
                "b": 629.0291137695312,
                "coord_origin": "BOTTOMLEFT"
              },
              "charspan": [
                0,
                205
              ]
            }
          ]
        }
      ],
      "headings": [
        "Artículo 18°"
      ],
      "captions": null,
      "origin": null
    }
  },
  {
    "text": "Las acciones del vendedor contra los terceros prescribirán a los seis meses contados a partir del día en que debería ser pagado o terminado de pagar el precio de la cosa vendida con reserva de dominio.",
    "meta": {
      "schema_name": "docling_core.transforms.chunker.DocMeta",
      "version": "1.0.0",
      "doc_items": [
        {
          "self_ref": "#/texts/45",
          "parent": {
            "cref": "#/body"
          },
          "children": [],
          "content_layer": "body",
          "meta": null,
          "label": "text",
          "prov": [
            {
              "page_no": 4,
              "bbox": {
                "l": 87.87554168701172,
                "t": 599.4818725585938,
                "r": 511.10443115234375,
                "b": 561.9487915039062,
                "coord_origin": "BOTTOMLEFT"
              },
              "charspan": [
                0,
                201
              ]
            }
          ]
        }
      ],
      "headings": [
        "Artículo 19°"
      ],
      "captions": null,
      "origin": null
    }
  },
  {
    "text": "El vendedor puede oponerse al embargo de la cosa vendida con reserva de dominio, practicado por los acreedores del comprador o los de un tercero, presentando el contrato de venta que llene los requisitos previstos en el Artículo 5 de esta Ley.",
    "meta": {
      "schema_name": "docling_core.transforms.chunker.DocMeta",
      "version": "1.0.0",
      "doc_items": [
        {
          "self_ref": "#/texts/47",
          "parent": {
            "cref": "#/body"
          },
          "children": [],
          "content_layer": "body",
          "meta": null,
          "label": "text",
          "prov": [
            {
              "page_no": 4,
              "bbox": {
                "l": 87.81719207763672,
                "t": 532.3548583984375,
                "r": 511.1111755371094,
                "b": 481.2998046875,
                "coord_origin": "BOTTOMLEFT"
              },
              "charspan": [
                0,
                243
              ]
            }
          ]
        }
      ],
      "headings": [
        "Artículo 20°"
      ],
      "captions": null,
      "origin": null
    }
  },
  {
    "text": "Asimismo, el comprador puede oponerse al embargo de la cosa practicado por los acreedores del vendedor o los de un tercero.",
    "meta": {
      "schema_name": "docling_core.transforms.chunker.DocMeta",
      "version": "1.0.0",
      "doc_items": [
        {
          "self_ref": "#/texts/48",
          "parent": {
            "cref": "#/body"
          },
          "children": [],
          "content_layer": "body",
          "meta": null,
          "label": "text",
          "prov": [
            {
              "page_no": 4,
              "bbox": {
                "l": 87.42041015625,
                "t": 478.6542053222656,
                "r": 510.9902038574219,
                "b": 456.7904968261719,
                "coord_origin": "BOTTOMLEFT"
              },
              "charspan": [
                0,
                123
              ]
            }
          ]
        }
      ],
      "headings": [
        "Artículo 20°"
      ],
      "captions": null,
      "origin": null
    }
  },
  {
    "text": "Cualquiera que sea su cuantía, las acciones legales que deriven de la aplicación de esta Ley, se iniciarán, sustanciarán y decidirán ante el juez competente por los trámites del juicio breve, conforme al procedimiento previsto en el Titulo XVI del Código de Procedimiento Civil.",
    "meta": {
      "schema_name": "docling_core.transforms.chunker.DocMeta",
      "version": "1.0.0",
      "doc_items": [
        {
          "self_ref": "#/texts/50",
          "parent": {
            "cref": "#/body"
          },
          "children": [],
          "content_layer": "body",
          "meta": null,
          "label": "text",
          "prov": [
            {
              "page_no": 4,
              "bbox": {
                "l": 87.81719207763672,
                "t": 425.154296875,
                "r": 511.064453125,
                "b": 374.01873779296875,
                "coord_origin": "BOTTOMLEFT"
              },
              "charspan": [
                0,
                278
              ]
            }
          ]
        }
      ],
      "headings": [
        "Artículo 21°"
      ],
      "captions": null,
      "origin": null
    }
  },
  {
    "text": "Cuando el vendedor ejerce la acción de reivindicación de la cosa vendida con reserva de dominio, el juez, al ordenar la citación del demandado, podrá decretar, a solicitud de parte, el secuestro de la cosa y su entrega al vendedor siempre que la demanda tenga apariencias de ser fundada y el vendedor constituya garantía suficiente para asegurar, caso de no prosperar la acción, la nueva entrega de la cosa vendida al demandado o la entrega de otra cosa equivalente y el pago de los daños y perjuicios causados por la medida decretada.",
    "meta": {
      "schema_name": "docling_core.transforms.chunker.DocMeta",
      "version": "1.0.0",
      "doc_items": [
        {
          "self_ref": "#/texts/52",
          "parent": {
            "cref": "#/body"
          },
          "children": [],
          "content_layer": "body",
          "meta": null,
          "label": "text",
          "prov": [
            {
              "page_no": 4,
              "bbox": {
                "l": 87.78218078613281,
                "t": 344.6932067871094,
                "r": 511.04132080078125,
                "b": 242.10813903808594,
                "coord_origin": "BOTTOMLEFT"
              },
              "charspan": [
                0,
                535
              ]
            }
          ]
        }
      ],
      "headings": [
        "Artículo 22°"
      ],
      "captions": null,
      "origin": null
    }
  },
  {
    "text": "En el auto en que se acuerde la entrega de la cosa al vencedor, el Juez ordenará que antes de proceder a la ejecución de esta medida se deje constancia del estado en que se encuentre la cosa y se haga un avalúo de ésta por un perito que nombrará en el mismo auto. Este avalúo será la base para establecer los pagos que, eventualmente, deban hacerse las partes en razón de los derechos que esta Ley les acuerda.",
    "meta": {
      "schema_name": "docling_core.transforms.chunker.DocMeta",
      "version": "1.0.0",
      "doc_items": [
        {
          "self_ref": "#/texts/53",
          "parent": {
