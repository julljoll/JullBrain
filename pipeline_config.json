{
  "version": "0.2.0",
  "ocr_activo": true,
  "generar_chunks": true,
  "min_article_chars": 50,
  "quality_threshold_critical": 0.90,
  "quality_threshold_warning": 0.95,
  "granite_model": "ibm-granite/granite-3.3-8b-instruct-GGUF",
  "granite_temperature": 0.0,
  "granite_top_p": 0.05,
  "granite_top_k": 20,
  "granite_repeat_penalty": 1.15,
  "granite_fixed_seed": 42,
  "granite_context_window": 128000,
  "granite_embedding_model": "ibm-granite/granite-embedding-311m-multilingual-r2",
  "embedding_backend": "sentence-transformers",
  "embedding_batch_size": 32,
  "embedding_device": "cpu",
  "opensearch_enabled": true,
  "opensearch_host": "localhost",
  "opensearch_port": 9200,
  "opensearch_index_name": "documents_legal_venezuela",
  "opensearch_dimension": 768,
  "openrag_enabled": true,
  "openrag_endpoint": "http://localhost:7860/api/v1",
  "guardian_enabled": true,
  "guardian_model": "granite3.1-dense:8b-guardian",
  "guardian_confidence_threshold": 0.85,
  "local_profile": {
    "embedding_device": "cpu",
    "embedding_batch_size": 32,
    "usar_half_precision": false,
    "max_workers": 4
  }
}
