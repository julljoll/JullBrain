{
  "ocr_activo": true,
  "generar_chunks": true,
  "min_article_chars": 50,
  "quality_threshold_critical": 0.90,
  "quality_threshold_warning": 0.95,
  "granite_model": "ibm-granite/granite-3.3-8b-instruct-GGUF",
  "granite_temperature": 0.0,
  "granite_top_p": 0.05,
  "granite_top_k": 20,
  "granite_repeat_penalty": 1.15,
  "granite_fixed_seed": 42,
  "ragflow_api_url": "http://localhost:9380/api/v1",
  "ragflow_embedding_model": "ibm-granite/granite-embedding-311m-multilingual-r2",
  "embedding_backend": "sentence-transformers",
  "embedding_batch_size": 32,
  "embedding_device": "cpu",
  "granite_context_window": 128000,
  "lightrag_enabled": true,
  "lightrag_working_dir": "./RAG/lightrag_db",
  "lightrag_mode": "hybrid",
  "guardian_enabled": true,
  "guardian_model": "granite3.1-dense:8b-guardian",
  "guardian_confidence_threshold": 0.85,
  "opensearch_enabled": true,
  "opensearch_host": "opensearch",
  "opensearch_port": 9200,
  "postgres_enabled": true,
  "postgres_host": "postgres",
  "postgres_port": 5432,
  "postgres_db": "jullbrain_db"
}
