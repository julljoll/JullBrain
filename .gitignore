# ==============================================================================
# JullBrain v0.2.0 — Reglas de Exclusión Git
# ==============================================================================

# Entorno Virtual Python
docling_env/
venv/
.venv/
__pycache__/
*.py[cod]
*$py.class

# Variables de entorno y secretos
.env
*.pem
*.key

# Logs y reportes de sesión
logs/
*.log
pipeline_report_*.json

# Pesos binarios de Modelos IA Locales (se preservan los directorios con .gitkeep)
RAG/modelos_ia/**/*.bin
RAG/modelos_ia/**/*.safetensors
RAG/modelos_ia/**/*.gguf
RAG/modelos_ia/**/*.onnx
RAG/modelos_ia/**/*.pt
RAG/modelos_ia/**/*.pth
RAG/modelos_ia/huggingface/hub/
RAG/modelos_ia/ollama/blobs/

# Bases de datos dinámicas locales
RAG/notebooks_db/*
!RAG/notebooks_db/.gitkeep
RAG/lightrag_db/*
!RAG/lightrag_db/.gitkeep

# Archivos del Sistema Operativo / IDE
.DS_Store
Thumbs.db
*.swp
