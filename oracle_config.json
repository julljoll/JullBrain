{
  "version": "0.2.0",
  "cloud_provider": "oracle_cloud_infrastructure",
  "container_engine": "podman",
  "region_recomendada": "sa-saopaulo-1",
  "perfiles_computo": {
    "always_free_arm64": {
      "shape": "VM.Standard.A1.Flex",
      "ocpus": 4,
      "memory_gb": 24,
      "os": "Oracle Linux 9 / Ubuntu 24.04 LTS (ARM64)",
      "docling_device": "cpu",
      "docling_threads": 4
    },
    "enterprise_gpu": {
      "shape": "VM.GPU.A10.1",
      "ocpus": 15,
      "memory_gb": 240,
      "os": "Oracle Linux 9 / Ubuntu 24.04 LTS (x86_64)",
      "docling_device": "cpu",
      "granite_device": "cuda"
    }
  },
  "almacenamiento_local_modelos": {
    "base_dir": "/opt/jullbrain/RAG",
    "datos_brutos": "/opt/jullbrain/RAG/datos_brutos",
    "informacion_docling_rag": "/opt/jullbrain/RAG/Informacion_docling_rag",
    "normativas_chunks": "/opt/jullbrain/RAG/normativas_chunks",
    "modelos_ia": "/opt/jullbrain/RAG/modelos_ia",
    "docling_artifacts": "/opt/jullbrain/RAG/modelos_ia/docling",
    "granite_embeddings": "/opt/jullbrain/RAG/modelos_ia/granite_embeddings",
    "granite_llm": "/opt/jullbrain/RAG/modelos_ia/granite_llm",
    "granite_guardian": "/opt/jullbrain/RAG/modelos_ia/granite_guardian",
    "ollama_models": "/opt/jullbrain/RAG/modelos_ia/ollama"
  },
  "modelos_ibm": {
    "llm": "ibm-granite/granite-3.3-8b-instruct-GGUF",
    "embeddings": "ibm-granite/granite-embedding-english-r2",
    "guardian": "ibm-granite/granite-guardian-3.2-5b"
  },
  "ciberseguridad": {
    "zero_trust": true,
    "air_gapped_ready": true,
    "hmac_sha256_audit_chain": true,
    "model_vault_sha256_verification": true,
    "podman_rootless": true
  }
}
