      ],
      "captions": null,
      "origin": null
    }
  },
  {
    "text": "Toda persona, natural o jurídica que exporte artículos producidos en el país, tendrá derecho a un crédito fiscal que se calculará en función del porcentaje de valor agregado nacional de cada bien exportado.",
    "meta": {
      "schema_name": "docling_core.transforms.chunker.DocMeta",
      "version": "1.0.0",
      "doc_items": [
