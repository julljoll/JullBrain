                "t": 348.90374755859375,
                "r": 542.3604125976562,
                "b": 286.4362487792969,
                "coord_origin": "BOTTOMLEFT"
              },
              "charspan": [
                0,
                206
              ]
            }
          ]
        }
      ],
      "headings": [
        "LEY DE INCENTIVO A LA EXPORTACION"
      ],
      "captions": null,
      "origin": null
    }
  },
  {
